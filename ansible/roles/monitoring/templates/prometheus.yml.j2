global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
          - "192.168.56.5:9100"
          - "192.168.56.10:9100"
          - "192.168.56.20:9100"
          - "192.168.56.30:9100"

  - job_name: cadvisor
    static_configs:
      - targets:
          - "192.168.56.10:8081"
          - "192.168.56.20:8081"
          - "192.168.56.30:8081"

  - job_name: jenkins
    metrics_path: /prometheus
    static_configs:
      - targets: ["192.168.56.10:8080"]

  - job_name: investhelper
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["http://{{ app_host }}:{{ app_port }}/health"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
